NODE_ENV=development
PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# The local UI uses the explicit demo payment flow. Production disables it.
PAYMENT_MODE=demo
VNPAY_HASH_SECRET=""

# Real VietQR bank transfer. Use PAYMENT_MODE=vietqr after filling these values.
VIETQR_BANK_ID=""
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""

# Secret configured in both SePay webhook settings and this backend only.
# Never expose this value in the frontend or commit a real key.
SEPAY_WEBHOOK_API_KEY=""

# Optional in development, required in production.
REDIS_URL="redis://127.0.0.1:6379"

# Optional. When omitted, the customer minibot uses Dibaoxa's local recommendation engine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"

# Personal flight search through Google Flights results via SerpApi.
# The free plan currently includes a limited monthly search quota.
# Create a key at https://serpapi.com/users/sign_up
SERPAPI_API_KEY=""

# Used only by prisma/seed.js. Production has no default value.
DEMO_PASSWORD="123456"
